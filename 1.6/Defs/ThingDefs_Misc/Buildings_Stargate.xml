<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>StarGate</defName>
    <label>StarGate</label>
    <description>An ancient ring-shaped device of unknown origin. It appears dormant, but its construction suggests a purpose far beyond decoration.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Stargate/Offline_Gate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5.5,3)</drawSize>
      <drawRotated>false</drawRotated>
      <shadowData>
        <volume>(3.8, 0.25, 1.25)</volume>
        <offset>(0, 0, -0.18)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(5,2)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>20</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
    <comps>
      <li Class="RimGateJaffaKree.CompProperties_StarGate">
        <onlineTexPaths>
          <li>Things/Building/Stargate/Online_Gate1</li>
          <li>Things/Building/Stargate/Online_Gate2</li>
        </onlineTexPaths>
        <onlineAnimationTicks>15</onlineAnimationTicks>
        <warmupTicks>120</warmupTicks>
        <stayOnlineTicks>1800</stayOnlineTicks>
        <postTravelOnlineTicks>600</postTravelOnlineTicks>
        <kawooshTicks>24</kawooshTicks>
        <kawooshLength>2.5</kawooshLength>
        <kawooshWidth>2</kawooshWidth>
        <drawPlaceholderKawoosh>false</drawPlaceholderKawoosh>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>StarGate_Control_Panel</defName>
    <label>StarGate control panel</label>
    <description>A nearby control device used to establish a connection between StarGates.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/StargatePanel/Neaktivni_panel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1)</drawSize>
      <drawRotated>false</drawRotated>
      <shadowData>
        <volume>(0.85, 0.16, 0.45)</volume>
        <offset>(0, 0, -0.08)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>10</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
    <comps>
      <li Class="RimGateJaffaKree.CompProperties_StarGateControlPanel">
        <activeTexPath>Things/Building/StargatePanel/Aktivni_panel</activeTexPath>
        <interactionTicks>180</interactionTicks>
        <linkedGateSearchRadius>8</linkedGateSearchRadius>
      </li>
    </comps>
  </ThingDef>

  <JobDef>
    <defName>UseStarGateControlPanel</defName>
    <driverClass>RimGateJaffaKree.JobDriver_UseStarGateControlPanel</driverClass>
    <reportString>uses StarGate control panel.</reportString>
  </JobDef>

  <JobDef>
    <defName>EnterStarGate</defName>
    <driverClass>RimGateJaffaKree.JobDriver_EnterStarGate</driverClass>
    <reportString>enters the StarGate.</reportString>
  </JobDef>

  <GenStepDef>
    <defName>StarGatePlanetSurface</defName>
    <order>300</order>
    <genStep Class="RimGateJaffaKree.GenStep_StarGatePlanetSurface" />
  </GenStepDef>

  <MapGeneratorDef ParentName="Base_Player" Name="StarGatePlanetBase" Abstract="True">
    <label>StarGate planet</label>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <genSteps>
      <li>StarGatePlanetSurface</li>
    </genSteps>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanet</defName>
    <pocketMapProperties>
      <biome>TemperateForest</biome>
      <temperature>21</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanetTemperate</defName>
    <pocketMapProperties>
      <biome>TemperateForest</biome>
      <temperature>21</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanetForest</defName>
    <pocketMapProperties>
      <biome>BorealForest</biome>
      <temperature>10</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanetDesert</defName>
    <pocketMapProperties>
      <biome>Desert</biome>
      <temperature>32</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanetIce</defName>
    <pocketMapProperties>
      <biome>IceSheet</biome>
      <temperature>-35</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanetToxic</defName>
    <pocketMapProperties>
      <biome>TemperateSwamp</biome>
      <temperature>18</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <MapGeneratorDef ParentName="StarGatePlanetBase">
    <defName>StarGatePlanetAncientRuins</defName>
    <pocketMapProperties>
      <biome>AridShrubland</biome>
      <temperature>24</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>true</preventPrisonerEscape>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
  </MapGeneratorDef>

  <WorldObjectDef>
    <defName>StarGatePlanetGateway</defName>
    <label>StarGate planetary gateway</label>
    <description>A persistent gateway location on a separate StarGate planet.</description>
    <worldObjectClass>MapParent</worldObjectClass>
    <texture>Things/Building/Stargate/Offline_Gate</texture>
    <selectable>true</selectable>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>70</expandingIconPriority>
    <canHaveMap>true</canHaveMap>
    <canBePlayerHome>false</canBePlayerHome>
    <mapGenerator>Base_Player</mapGenerator>
    <overrideMapSize>(150, 1, 150)</overrideMapSize>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
    </comps>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>StarGatePocketPlanet</defName>
    <label>StarGate planet</label>
    <description>A generated destination reached through a StarGate address.</description>
    <worldObjectClass>MapParent</worldObjectClass>
    <texture>Things/Building/Stargate/Offline_Gate</texture>
    <selectable>false</selectable>
    <expandingIcon>false</expandingIcon>
    <canHaveMap>true</canHaveMap>
    <canBePlayerHome>false</canBePlayerHome>
    <mapGenerator>Base_Player</mapGenerator>
    <overrideMapSize>(150, 1, 150)</overrideMapSize>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>StarGatePlanetPocketMap</defName>
    <label>StarGate planet</label>
    <description>A persistent off-world location connected to a saved StarGate address.</description>
    <worldObjectClass>RimGateJaffaKree.StarGatePlanetMapParent</worldObjectClass>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>StarGateWorldSite</defName>
    <label>StarGate</label>
    <description>An ancient dormant gate hidden somewhere on this world.</description>
    <worldObjectClass>MapParent</worldObjectClass>
    <texture>Things/Building/Stargate/Offline_Gate</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>65</expandingIconPriority>
    <canHaveMap>true</canHaveMap>
    <canBePlayerHome>false</canBePlayerHome>
    <mapGenerator>Base_Player</mapGenerator>
    <overrideMapSize>(150, 1, 150)</overrideMapSize>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
    </comps>
  </WorldObjectDef>
</Defs>
